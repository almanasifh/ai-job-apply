{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-job-apply/artifact.schema.json",
  "title": "Application artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "candidate_id", "application_id", "path", "media_type", "byte_count", "sha256", "qa_status", "source_fact_ids"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^artifact_[a-z0-9-]+$" },
    "candidate_id": { "type": "string" },
    "application_id": { "type": "string" },
    "path": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "minLength": 1 },
    "byte_count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "qa_status": { "enum": ["PASSED", "FAILED", "PENDING"] },
    "source_fact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}
