{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-job-apply/authorization.schema.json",
  "title": "Application authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "scope", "approver_ref", "issued_at", "expires_at", "bindings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "approval_id": { "type": "string", "pattern": "^approval_[a-z0-9-]+$" },
    "scope": { "enum": ["EXACT", "BATCH"] },
    "approver_ref": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["application_id", "version", "candidate_id", "job_id", "channel", "sender_account_ref", "destination", "payload_digest", "artifact_hashes"],
        "properties": {
          "application_id": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "candidate_id": { "type": "string" },
          "job_id": { "type": "string" },
          "channel": { "enum": ["EMAIL", "PORTAL", "LINKEDIN", "MANUAL"] },
          "sender_account_ref": { "type": ["string", "null"] },
          "destination": { "type": "string" },
          "payload_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifact_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    }
  }
}
